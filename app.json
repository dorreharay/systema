{
  "expo": {
    "name": "re:string",
    "slug": "systema",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "systema",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.velar.restring",
      "appleTeamId": "SGMN4DGZ42",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "backgroundColor": "#0b1210",
    "android": {
      "package": "com.velar.restring",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/EuclidCircularA-Light.ttf",
            "./assets/fonts/EuclidCircularA-Regular.ttf",
            "./assets/fonts/EuclidCircularA-Medium.ttf",
            "./assets/fonts/EuclidCircularA-SemiBold.ttf",
            "./assets/fonts/EuclidCircularA-Bold.ttf",
            "./assets/fonts/EuclidCircularA-Italic.ttf",
            "./assets/fonts/FixelStylistic-Bold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "re:string uses your photos so you can attach pictures of a racket to an order.",
          "cameraPermission": "re:string uses the camera so you can photograph a racket for an order.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1aa37823-550e-40e0-b9e8-909265bb86f7"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1aa37823-550e-40e0-b9e8-909265bb86f7"
      }
    },
    "owner": "dorreharay-team"
  }
}
