{
  "expo": {
    "name": "systema",
    "slug": "systema",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "systema",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.dorreharay.systema",
      "appleTeamId": "SGMN4DGZ42"
    },
    "backgroundColor": "#0b1210",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/EuclidCircularA-Light.ttf",
            "./assets/fonts/EuclidCircularA-Regular.ttf",
            "./assets/fonts/EuclidCircularA-Medium.ttf",
            "./assets/fonts/EuclidCircularA-SemiBold.ttf",
            "./assets/fonts/EuclidCircularA-Bold.ttf",
            "./assets/fonts/EuclidCircularA-Italic.ttf",
            "./assets/fonts/FixelStylistic-Bold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1aa37823-550e-40e0-b9e8-909265bb86f7"
      }
    },
    "owner": "dorreharay-team"
  }
}
