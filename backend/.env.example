# Copy to .env (git-ignored) and fill in.

# Database. A local PostgreSQL: postgresql://<your OS user>@localhost:5432/systema
# On Railway the PostgreSQL plugin sets this for you.
DATABASE_URL=postgresql://localhost:5432/systema
# TLS to the database. Default: on in production, off otherwise.
# DATABASE_SSL=false

# App
NODE_ENV=development
PORT=4000
APP_NAME=re:string

# Where the links in emails (a password reset) point, and in production the only origin a browser may call the API from.
# For the native app it is the public https address of this API: it serves the page at /reset-password, which opens the
# app with the token, because mail clients do not make the app's own address (systema://…) a link.
APP_URL=http://localhost:8081
# The app's own URL scheme (app.json: scheme), which that page opens the app with. Default: systema
# APP_SCHEME=systema
# Extra browser origins, comma separated (replaces the defaults for development)
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Proxies in front of the server (Railway, a load balancer). Default: 1 in production, 0 otherwise.
# TRUST_PROXY=1
# For a host whose number of proxies is not fixed (Railway): the header its own edge sets with the client's address. The
# limit on login attempts counts by it. Without it the address is `req.ip`, which is only right if TRUST_PROXY is.
# CLIENT_IP_HEADER=x-real-ip

# Auth. Generate with: openssl rand -base64 48
JWT_SECRET=
# bcrypt cost, default 12. Lower it only in tests.
# BCRYPT_ROUNDS=12
# Attempts per IP and 15 minutes at login, sign-up and password reset, default 20.
# AUTH_RATE_LIMIT_MAX=20

# Sign in with Google: the OAuth client IDs an ID token may be meant for, comma separated. List the Web client ID (the one
# the app asks Google for the token with) and, if you like, the iOS one. Empty turns Google sign-in off.
# Where to get them and how to set it all up: ../docs/google-sign-in.md
GOOGLE_CLIENT_IDS=
# Only a test changes these two: where Google answers about the access token the web build signs in with, and about the person.
# GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
# GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Sign in with Apple: the identifiers (comma separated) that an identity token may be meant for. The bundle ID of the app
# first; then, to offer the sign-in in the browser too, the Services ID of the web sign-in (see ../docs/web-sign-in.md), e.g.
# APPLE_CLIENT_IDS=com.example.app,com.example.app.web. Empty turns Apple sign-in off.
APPLE_CLIENT_IDS=
# Optional: to let the server trade the authorization code of a sign-in for a token and revoke it when an account is deleted
# (Apple expects that of an app that offers account deletion), give it a Sign in with Apple key from the Apple Developer
# account (Keys): the Team ID, the Key ID and the text of the .p8 file, on one line with \n for its line breaks. All three or
# none, and they need APPLE_CLIENT_IDS above. See README.md.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----
# Only a test changes these two: where Apple publishes its keys, and the base of its /token and /revoke endpoints.
# APPLE_KEYS_URL=https://appleid.apple.com/auth/keys
# APPLE_AUTH_URL=https://appleid.apple.com/auth

# Email (optional: without either of the two below, emails are printed to the console instead of sent).
# Who emails come from, whichever way they go out. The address has to be on a domain verified with the email service.
# EMAIL_FROM_NAME=re:string
# EMAIL_FROM_ADDRESS=noreply@mail.example.com
#
# Resend, over HTTPS: the way to send from a host that allows no SMTP (Railway's Hobby plan blocks ports 25, 465 and 587).
# The API key, from resend.com/api-keys. With it set, SMTP below is not used. See ../docs/email.md
# RESEND_API_KEY=
#
# Or SMTP (SMTP_FROM_NAME and SMTP_FROM_ADDRESS are the sender when EMAIL_FROM_* are not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_NAME=re:string
# SMTP_FROM_ADDRESS=noreply@example.com

# Confirming the email address of an account made with an email and a password: a code of six digits is emailed, and until it is typed in
# the account is turned away from everything but a few routes (403 email_not_verified). On in production and off everywhere else, so a
# local server asks for nothing. Set it to true to try the whole thing locally (with no email service the code is printed to the console);
# set it to false in production to switch it off, e.g. until the app version that asks for the code is out. Accounts that exist when
# the migration runs count as confirmed. See README.md.
# EMAIL_VERIFICATION_REQUIRED=false
# How long a code works, in minutes. Default 15.
# EMAIL_CODE_MINUTES=15
# How many wrong codes one code takes before a new one has to be asked for. Default 5.
# EMAIL_CODE_ATTEMPTS=5
# How many seconds a person waits before asking for another code, and how many codes they may be sent in an hour. Defaults 60 and 6.
# EMAIL_CODE_RESEND_SECONDS=60
# EMAIL_CODE_SENDS_PER_HOUR=6

# Whether a new account starts with a catalog of common rackets and strings, none in stock. Default: true.
# STARTER_CATALOG=true

# Subscription plans (see ../docs/subscriptions.md). Off unless turned on: every account has everything, nothing is counted and the app
# shows no plans. Do not turn it on in production before the store is connected.
# BILLING_ENABLED=false
# What Free allows: new orders in a calendar month of the stringer's own. Default 15.
# FREE_ORDERS_PER_MONTH=15
# How many days a plan that has run out still holds (the store is slow with a renewal). Default 3.
# BILLING_GRACE_DAYS=3
# Development only, and never in production whatever is set: POST /api/billing/dev-grant gives the signed-in account a plan by hand.
# BILLING_DEV_GRANTS=false
# The store, through RevenueCat (see ../docs/subscriptions.md). The secret key of its API v1 (sk_...): without it the server cannot ask
# RevenueCat what an account holds (POST /api/billing/sync answers 503).
# REVENUECAT_SECRET_KEY=
# The value of the Authorization header that RevenueCat's webhook sends (a long random string, set in its dashboard too). Without it the
# route POST /api/billing/revenuecat does not exist.
# REVENUECAT_WEBHOOK_AUTH=
# The names of the entitlements in RevenueCat's dashboard. Defaults: pro, studio.
# REVENUECAT_PRO_ENTITLEMENT=pro
# REVENUECAT_STUDIO_ENTITLEMENT=studio
# How many times a minute one address may ask the server to read the store again (POST /api/billing/sync). Default 10.
# BILLING_SYNC_RATE_LIMIT_MAX=10

# Studio, the plan for a workshop of several people (see ../docs/studio.md). Off unless turned on, and it needs BILLING_ENABLED too: Studio is
# then only a waiting list, there are no team routes and nobody can be invited. Do not turn it on in production before the store sells Studio.
# STUDIO_ENABLED=false
# How many people a Studio workshop holds, the owner included (invitations that are waiting take a seat). Default 3.
# STUDIO_SEATS=3
# How many days an invitation to a workshop can be used. Default 7.
# STUDIO_INVITE_DAYS=7

# First admin: created on start when the database has no users yet. Both are needed.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Admin
