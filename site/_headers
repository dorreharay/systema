# Read by Netlify and Cloudflare Pages (same format); other hosts ignore it. The CSP is what keeps "no third-party anything" true:
# scripts, fonts, frames and inline styles are not allowed, so none can slip in unnoticed.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
